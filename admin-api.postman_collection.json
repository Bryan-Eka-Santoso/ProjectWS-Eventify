{
  "info": {
    "name": "Eventify — Admin API",
    "description": "Semua endpoint admin Eventify. Import ke EchoAPI/Postman. Auth mengikuti konvensi tim: kirim role=admin (dan user_id admin) di query/body — tidak pakai token. Set variable baseUrl sesuai port server (default http://localhost:5000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "voucherId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "chatRoomId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "commentId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Create category (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Music\",\n  \"description\": \"Konser & pertunjukan musik\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Update category (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Music & Concert\",\n  \"description\": \"Updated description\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "categories",
                "{{categoryId}}"
              ]
            }
          }
        },
        {
          "name": "Delete category (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "categories",
                "{{categoryId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Discounts (Vouchers)",
      "item": [
        {
          "name": "List all vouchers (admin, incl. inactive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/vouchers/admin-list?role=admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "vouchers",
                "admin-list"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "admin"
                }
              ]
            }
          }
        },
        {
          "name": "Create voucher (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"NEWYEAR25\",\n  \"name\": \"Diskon Tahun Baru\",\n  \"percentage\": 25,\n  \"max_cut\": 50000,\n  \"points_required\": 100,\n  \"stock\": 50,\n  \"valid_until\": \"2026-12-31\",\n  \"is_active\": true,\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/vouchers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "vouchers"
              ]
            }
          }
        },
        {
          "name": "Update voucher (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"NEWYEAR25\",\n  \"name\": \"Diskon Tahun Baru (Updated)\",\n  \"percentage\": 30,\n  \"max_cut\": 60000,\n  \"points_required\": 120,\n  \"stock\": 40,\n  \"valid_until\": \"2026-12-31\",\n  \"is_active\": false,\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/vouchers/{{voucherId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "vouchers",
                "{{voucherId}}"
              ]
            }
          }
        },
        {
          "name": "Delete voucher (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/vouchers/{{voucherId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "vouchers",
                "{{voucherId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Events (Moderation)",
      "item": [
        {
          "name": "List all events (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/admin/all-events?role=admin&status=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "admin",
                "all-events"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "admin"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "optional: draft|pending_approval|published|rejected|canceled|completed"
                }
              ]
            }
          }
        },
        {
          "name": "Change event status (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"published\",\n  \"user_id\": {{adminId}},\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventId}}",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Chat Rooms",
      "item": [
        {
          "name": "List all chat rooms (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/community/admin/all-rooms?role=admin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "community",
                "admin",
                "all-rooms"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "admin"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "optional name/description search"
                }
              ]
            }
          }
        },
        {
          "name": "Force-delete chat room (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/community/admin/rooms/{{chatRoomId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "community",
                "admin",
                "rooms",
                "{{chatRoomId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cancellation Requests",
      "item": [
        {
          "name": "List cancellation requests (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/cancellation-requests?user_id={{adminId}}&role=admin&status=pending&page=1&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "cancellation-requests"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{adminId}}"
                },
                {
                  "key": "role",
                  "value": "admin"
                },
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Approve cancellation request (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/cancellation-requests/{{requestId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "cancellation-requests",
                "{{requestId}}",
                "approve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"role\": \"admin\",\n  \"admin_note\": \"Alasan valid, pembatalan disetujui.\"\n}"
            }
          }
        },
        {
          "name": "Reject cancellation request (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/events/cancellation-requests/{{requestId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "cancellation-requests",
                "{{requestId}}",
                "reject"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"role\": \"admin\",\n  \"admin_note\": \"Alasan tidak cukup kuat.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "List all users (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/social/admin/users?role=admin",
              "host": [
